# Copia a baseline.conf (ignorado por git) y ajusta a tu organización.
# new-repo.sh lo carga para rellenar los valores por defecto de los prompts.

BASELINE_ORG="mi-usuario"
BASELINE_REPO="security-baseline"
BASELINE_REF="v1"

# Publicación (déjalos vacíos si no usas CD)
DTRACK_URL="https://dependency-track.example.internal"
